+static inline void __get_fault_insn_par(u64 esr, struct kvm_vcpu_fault_info *fault)
+{
+	u64 par, tmp;
+
+	fault->insn_par = SYS_PAR_EL1_F;
+	if (ESR_ELx_EC(esr) != ESR_ELx_EC_DABT_LOW || (esr & ESR_ELx_ISV))
+		return;

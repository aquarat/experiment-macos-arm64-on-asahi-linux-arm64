# GitHub Actions on throwaway macOS guests. Install:
#   sudo install -m 644 systemd/vmapple-gha-runner.service /etc/systemd/system/
#   sudo install -d -m 700 /etc/vmapple-runner
#   sudo install -m 600 /dev/null /etc/vmapple-runner/github.env   # then fill in:
#     GH_SCOPE=repos/<owner>/<repo>   (or orgs/<org>)
#     GH_TOKEN=...   (a token that may create JIT runner configs)
#   Before installing, replace <runner-user> with the account that owns the
#   checkout and VM images, and /path/to/checkout with the checkout path.
#   sudo systemctl daemon-reload && sudo systemctl enable --now vmapple-gha-runner
# Each unit starts VM_SLOTS guests (hosts/<host>.env). Apple's licence allows two
# macOS VMs per Mac: run one of the two units per host, or split VM_SLOTS.
[Unit]
Description=GitHub Actions runner: ephemeral macOS guests
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/vmapple-runner/github.env

[Service]
User=<runner-user>
WorkingDirectory=/path/to/checkout
EnvironmentFile=/etc/vmapple-runner/github.env
ExecStart=/usr/bin/bash /path/to/checkout/scripts/runner-service.sh gha
# Run via bash: SELinux (Fedora) refuses to exec scripts labelled user_home_t.
# Stop: every process gets SIGTERM; each vm-job then discards its guest and
# clone (KillMode=control-group, the default) before systemd's SIGKILL.
TimeoutStopSec=150
Restart=on-failure
RestartSec=60

[Install]
WantedBy=multi-user.target

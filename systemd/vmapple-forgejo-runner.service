# Forgejo Actions on throwaway macOS guests. Install:
#   sudo install -m 644 systemd/vmapple-forgejo-runner.service /etc/systemd/system/
#   sudo install -d -m 700 /etc/vmapple-runner
#   sudo install -m 600 /dev/null /etc/vmapple-runner/forgejo.env   # then fill in:
#     FORGEJO_URL=https://forge.example
#     FORGEJO_REGISTRATION_TOKEN=...      (or FORGEJO_TOKEN + FORGEJO_SCOPE)
#   Before installing, replace <runner-user> with the account that owns the
#   checkout and VM images, and /path/to/checkout with the checkout path.
#   sudo systemctl daemon-reload && sudo systemctl enable --now vmapple-forgejo-runner
# Each unit starts VM_SLOTS guests (hosts/<host>.env). Apple's licence allows two
# macOS VMs per Mac: run one of the two units per host, or split VM_SLOTS.
[Unit]
Description=Forgejo Actions runner: ephemeral macOS guests
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/vmapple-runner/forgejo.env

[Service]
User=<runner-user>
WorkingDirectory=/path/to/checkout
EnvironmentFile=/etc/vmapple-runner/forgejo.env
ExecStart=/usr/bin/bash /path/to/checkout/scripts/runner-service.sh forgejo
# Run via bash: SELinux (Fedora) refuses to exec scripts labelled user_home_t.
# Stop: every process gets SIGTERM; each vm-job then discards its guest and
# clone (KillMode=control-group, the default) before systemd's SIGKILL.
TimeoutStopSec=150
Restart=on-failure
# forgejo-runner one-job logs every 2 s poll; keep those out of the journal.
LogFilterPatterns=~received no task
RestartSec=60

[Install]
WantedBy=multi-user.target

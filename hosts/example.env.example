# Host profile template. Copy to hosts/<short hostname>.env (scripts/runner-service.sh
# loads hosts/$(hostname -s).env unless HOST_PROFILE is set) and edit.
# hosts/*.env is git-ignored, so per-machine profiles stay local.
#
# Before first use on a host:
#  1. Build the host kernel from the SRPM matching its running stock kernel:
#       scripts/build-host-kernel.sh <base .src.rpm> vmapple2 [extra patches]
#     If the host updates m1n1 automatically, installing a kernel also rewrites
#     the ESP's m1n1 stage 2 with that kernel's DTBs.
#  2. Verify KVM: dmesg must show "ACTLR virtualization (IMPDEF, Apple)" and VHE.
#     Run Ventura and Tahoe boot loops before trusting a new SoC.
#  3. Optional: bridge a wired Ethernet into br0 from a local console (see
#     scripts/host-net-setup.sh), then: sudo scripts/host-net-setup.sh taps br0 <slots>
#  4. Copy the golden bundles and AVPBooter (they are host-independent).
#
# Use by hand:  set -a; . hosts/<host>.env; set +a
HOST_SOC=t600x                 # e.g. t6001 (M1 Max), t6002 (M1 Ultra)
KERNEL_BASE_SRPM=              # path to the base kernel .src.rpm
KERNEL_EXTRA_PATCHES=          # optional extra test patches, space-separated
KERNEL_BUILDID=vmapple2
# Size slots so the host keeps a few CPUs and some GiB of RAM for itself.
# Apple's licence allows at most two macOS VMs per Mac.
VM_SLOTS=1
CPUS=8
RAM=16G
GOLDEN=$HOME/vm-artifacts/tahoe-26.4-25E246-v7
# Set to vmtap to give slot N the tap vmtapN (bridged NIC); empty = user-mode NAT only.
NET_TAP_PREFIX=
VK_DRIVER_FILES=/usr/share/vulkan/icd.d/lvp_icd.aarch64.json
